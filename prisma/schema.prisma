generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String
  excerpt     String?
  type        PostType
  status      PostStatus @default(DRAFT)
  promptId    String?
  coverImage  String?
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?

  prompt WeeklyPrompt? @relation(fields: [promptId], references: [id])
}

model WeeklyPrompt {
  id           String   @id @default(cuid())
  weekOf       DateTime @unique
  promptText   String
  theme        String?
  createdAt    DateTime @default(now())
  promptBankId String?

  posts      Post[]
  bankPrompt PromptBank? @relation(fields: [promptBankId], references: [id])
}

model PromptBank {
  id         String    @id @default(cuid())
  promptText String
  theme      String?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  sortOrder  Int       @default(0)

  weeklyPrompt WeeklyPrompt[]
}

model AdminCredentials {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  updatedAt    DateTime @updatedAt
}

enum PostType {
  PROMPTED
  FREE
}

enum PostStatus {
  DRAFT
  PUBLISHED
}
